    { "foreground": "#767676", "background": "#FFFFFF", "ratio": 4.54 },
    { "foreground": "#1B3A5C", "background": "#F4F7FA", "ratio": 10.81 },
    { "foreground": "#E6EEF5", "background": "#14202C", "ratio": 14.07 },
    { "foreground": "#123456", "background": "#123456", "ratio": 1 }
